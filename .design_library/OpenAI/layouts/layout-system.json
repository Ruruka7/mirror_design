{
  "brand": "OpenAI",
  "maxContentWidth": "1200px",
  "sectionSpacing": "80px 0",
  "containerPadding": "0 24px",
  "gridGap": "24px",
  "breakpoints": {
    "mobile": "375px",
    "tablet": "768px",
    "desktop": "1024px",
    "wide": "1440px"
  },
  "gridPatterns": [
    { "name": "3-col-auto", "template": "repeat(3, 1fr)", "usage": "product cards, customer stories", "responsive": "1-col below 768px" },
    { "name": "2-col-50-50", "template": "1fr 1fr", "usage": "content split sections", "responsive": "1-col below 768px" },
    { "name": "4-col-footer", "template": "repeat(4, 1fr)", "usage": "footer links", "responsive": "2-col below 768px, 1-col below 375px" }
  ],
  "sectionHeights": {
    "hero": "600px",
    "featureGrid": "480px",
    "contentSplit": "500px",
    "ctaBanner": "320px",
    "footer": "400px"
  },
  "navBehavior": {
    "type": "sticky",
    "height": "64px",
    "layout": "flex-row space-between"
  }
}
