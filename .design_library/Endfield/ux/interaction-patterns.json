    { "name": "scroll-section-reveal", "type": "scroll", "trigger": "section enters viewport 30%", "effect": "clip-path reveal + fade", "duration": "0.6s", "easing": "ease-out", "sections": ["operator-intel", "feature-split", "card-grid-info"] },
