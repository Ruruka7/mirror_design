{
  "brand": "Endfield",
  "maxContentWidth": "1400px",
  "sectionSpacing": "0px",
  "containerPadding": "0 24px",
  "gridGap": "24px",
  "breakpoints": {
    "mobile": "375px",
    "tablet": "768px",
    "desktop": "1024px",
    "wide": "1920px"
  },
  "gridPatterns": [
    { "name": "2-col-60-40", "template": "3fr 2fr", "usage": "operator display + info", "responsive": "1-col below 768px" },
    { "name": "3-col-media", "template": "repeat(3, 1fr)", "usage": "media gallery, info cards", "responsive": "2-col below 768px, 1-col below 375px" },
    { "name": "2-col-50-50", "template": "1fr 1fr", "usage": "gameplay split", "responsive": "1-col below 768px" },
    { "name": "flex-row-timeline", "template": "flex-row", "usage": "version calendar", "responsive": "horizontal scroll below 768px" }
  ],
  "sectionHeights": {
    "hero": "1080px (100vh)",
    "operatorIntel": "800px",
    "worldview": "600px",
    "mediaGallery": "500px",
    "timeline": "400px",
    "featureSplit": "600px",
    "cardGrid": "500px",
    "footer": "300px"
  },
  "navBehavior": {
    "type": "sticky",
    "height": "72px",
    "layout": "flex-row space-between"
  }
}
